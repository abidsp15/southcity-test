# Copy file ini jadi .env lalu isi API key-nya

# ===== AI / LLM =====
# Bisa pakai penyedia apa saja yang kompatibel dengan OpenAI API
LLM_API_KEY=isi_api_key_disini
LLM_MODEL=gpt-4o-mini
# Kosongkan kalau pakai OpenAI. Contoh lain:
#   Groq   -> LLM_BASE_URL=https://api.groq.com/openai/v1  (LLM_MODEL=llama-3.3-70b-versatile)
#   Gemini -> LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/  (LLM_MODEL=gemini-2.5-flash)
LLM_BASE_URL=

# ===== Database =====
# sqlite = otomatis dibuat dari schema.sql, tidak perlu install database
# mssql  = pakai SQL Server
DB_TYPE=sqlite
SQLITE_PATH=southcity.db

# Kalau DB_TYPE=mssql, isi connection string-nya (pakai user yang read-only)
# MSSQL_CONN_STR=DRIVER={ODBC Driver 18 for SQL Server};SERVER=localhost;DATABASE=SouthCity;UID=ai_reader;PWD=password_kamu;TrustServerCertificate=yes
MSSQL_CONN_STR=
